{
  "name": "Enterprise_Banking_Platform",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "start:frontend": "pnpm --filter banking-web start",
    "lint:frontend": "pnpm --filter banking-web lint",
    "typecheck:frontend": "pnpm --filter banking-web typecheck",
    "format:frontend": "pnpm --filter banking-web format",

    "start:card_processor_mock": "pnpm --filter card_processor_mock start:dev",
    "lint:card_processor_mock": "pnpm --filter card_processor_mock lint",
    "typecheck:card_processor_mock": "pnpm --filter card_processor_mock typecheck",
    "format:card_processor_mock": "pnpm --filter card_processor_mock format",

    "start:backend": "cd apps/banking_backend && .\\mvnw.cmd spring-boot:run",
    "lint:backend": "cd apps/banking_backend && .\\mvnw.cmd -q spotless:check",
    "typecheck:backend": "cd apps/banking_backend && .\\mvnw.cmd -q -o compile",
    "format:backend": "cd apps/banking_backend && .\\mvnw.cmd -q spotless:apply"
  }
}
