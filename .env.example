# Szablon zmiennych stosu (bez sekretów produkcyjnych). Użycie lokalne:
#   cp .env.example .env
#   docker compose -f deploy/compose.yml -f deploy/compose.dev.yml --env-file .env up -d --build
# Ten plik jest też kopiowany na hosta produkcyjnego jako config.env przy
# pierwszym wdrożeniu (deploy.config_file w .github/ci/projects.json) — tylko
# gdy zdalny config.env jeszcze nie istnieje.
REGISTRY=local
IMAGE_TAG=dev

# Metadane obrazu (OCI labels), wymagane przez create_docker_image.sh.
IMAGE_TITLE=Enterprise Banking Platform
IMAGE_DESCRIPTION=Bankowa platforma korporacyjna — backend, frontend i serwisy mockowe
IMAGE_VENDOR=robert_neat
IMAGE_LICENSES=UNLICENSED
IMAGE_SOURCE=https://github.com/RobertNeat/Enterprise_Banking_Platform

# PostgreSQL używany wyłącznie przez banking_backend (Spring Data JPA).
# Na serwerze produkcyjnym zmienić hasło przed pierwszym wdrożeniem.
BANKING_DB_NAME=banking
BANKING_DB_USER=banking
BANKING_DB_PASSWORD=change-me

# Czy banking_backend ma zasiać dane mockowe (Liquibase context mock-data) przy starcie.
# Lokalnie/dev domyślnie true; w produkcji (config.env) pozostaje false, jeśli nie ustawione inaczej.
BANKING_SEED_MOCK_DATA=true

# Sekret HS256 do podpisywania JWT wydawanych przez banking_backend (min. 32 bajty).
# Na serwerze produkcyjnym zmienić przed pierwszym wdrożeniem.
BANKING_JWT_SECRET=change-me-change-me-change-me-32b

# Czy serwisy mockowe (stan tylko w pamięci procesu) maja zasiac dane startowe zgodne
# z identyfikatorami z seeda banking_backend (card_authorization_ref/chargeback_ref/
# payment_card, loan_stage_transition, enforcement_case). Lokalnie/dev domyślnie true.
CARD_PROCESSOR_SEED_MOCK_DATA=true
GOVERNANCE_SEED_MOCK_DATA=true
GATEWAY_SEED_MOCK_DATA=true
