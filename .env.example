# === Registry & image tagging ===
# REGISTRY - Docker registry prefix used when building/pushing images (e.g. local, ghcr.io/org); required, missing value aborts build/deploy
# IMAGE_TAG - tag applied to built images (e.g. dev, sha, vX.Y.Z)
REGISTRY=local
IMAGE_TAG=dev

# === Image metadata (OCI labels, required by create_docker_image.sh) ===
# IMAGE_TITLE - org.opencontainers.image.title label (product name shown in image metadata)
# IMAGE_DESCRIPTION - org.opencontainers.image.description label (short description of image contents)
# IMAGE_VENDOR - org.opencontainers.image.vendor label (image owner/vendor)
# IMAGE_LICENSES - org.opencontainers.image.licenses label (license identifier, e.g. UNLICENSED, MIT)
# IMAGE_SOURCE - org.opencontainers.image.source label (source repository URL)
IMAGE_TITLE=Enterprise Banking Platform
IMAGE_DESCRIPTION=Bankowa platforma korporacyjna — backend, frontend i serwisy mockowe
IMAGE_VENDOR=robert_neat
IMAGE_LICENSES=UNLICENSED
IMAGE_SOURCE=https://github.com/RobertNeat/Enterprise_Banking_Platform

# Sekret HS256 do podpisywania i weryfikacji JWT wydawanych przez banking_backend.
# === JWT Authorization (banking_backend) ===
# BANKING_JWT_SECRET - HS256 signing secret, required min. 32 bytes (too short = backend will not start); required, change on server
BANKING_JWT_SECRET=change-me-change-me-change-me-32b

# === PostgreSQL (banking_backend only, container: postgres) ===
# BANKING_DB_NAME - database name (POSTGRES_DB + SPRING_DATASOURCE_URL); required, missing value fails `compose config`
# BANKING_DB_USER - database user (POSTGRES_USER + SPRING_DATASOURCE_USERNAME); required
# BANKING_DB_PASSWORD - database password (POSTGRES_PASSWORD + SPRING_DATASOURCE_PASSWORD); required, change on server
BANKING_DB_NAME=banking
BANKING_DB_USER=banking
BANKING_DB_PASSWORD=change-me

# === Mock data seeding ===
# BANKING_SEED_MOCK_DATA - true|false, seeds Liquibase mock-data context in banking_backend on startup; default (unset) = false
# CARD_PROCESSOR_SEED_MOCK_DATA - true|false, seeds card_processor_mock in-memory state (card_authorization_ref/chargeback_ref/payment_card) aligned with banking_backend seed ids; default (unset) = true
# GOVERNANCE_SEED_MOCK_DATA - true|false, seeds governance_mock in-memory state (approval/governance data) aligned with banking_backend seed ids; default (unset) = true
# GATEWAY_SEED_MOCK_DATA - true|false, seeds external_institutions_gateway_mock in-memory state (loan_stage_transition, enforcement_case / regulatory submissions) aligned with banking_backend seed ids; default (unset) = true
BANKING_SEED_MOCK_DATA=true
CARD_PROCESSOR_SEED_MOCK_DATA=true
GOVERNANCE_SEED_MOCK_DATA=true
GATEWAY_SEED_MOCK_DATA=true